    <string name="secao_historia">Nossa história</string>
    <string name="historia_texto">A Fazenda Santa Tereza, em São Luís de Montes Belos (GO), trabalha há mais de 22 anos com melhoramento genético da raça Nelore. Tudo começou em 2001, em parceria com João Hissassi Yano, a partir de embriões. A família Yano segue esse legado com foco em mansidão do rebanho e valorização da maternidade.</string>
    <string name="secao_linha_tempo">Linha do tempo</string>
    <string name="tempo_2001_ano">2001</string>
    <string name="tempo_2001">Início na pecuária Nelore, com embriões e inseminação artificial.</string>
    <string name="tempo_2011_ano">2011</string>
    <string name="tempo_2011">Entrada na ANCP e no PMGZ; aquisição de animais de grandes programas de melhoramento.</string>
    <string name="tempo_2024_ano">2024</string>
    <string name="tempo_2024">1º Leilão Matrizes Fazenda Santa Tereza (18/02/2024), transmitido pelo Canal do Boi.</string>
    <string name="secao_missao">Missão, visão e valores</string>
    <string name="missao">Missão: superar as expectativas de melhoramento dos clientes, promovendo qualidade superior na criação Nelore.</string>
    <string name="visao">Visão: transformar a pecuária por meio de avanços genéticos, com acesso a linhagens Nelore de destaque.</string>
    <string name="valores">Valores: satisfação dos clientes e desenvolvimento do rebanho de quem compra conosco.</string>
